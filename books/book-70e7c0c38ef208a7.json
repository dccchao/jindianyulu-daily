{
  "sourceSha256": "7d3b02d97a7aad1c810aabe64cdbaa3f4c40d694a090581c193e96c3b358faee",
  "omittedLongSentences": 0,
  "originalBodySentences": 188,
  "bodyFilterVersion": 2,
  "title": "毛泽东选集",
  "version": 1,
  "quotes": [
    {
      "id": 1,
      "text": "革命不是请客吃饭，不是做文章。",
      "source": "《毛泽东选集》 · 正文摘录 1"
    },
    {
      "id": 2,
      "text": "矫枉必须过正，不过正不能矫枉。",
      "source": "《毛泽东选集》 · 正文摘录 2"
    },
    {
      "id": 3,
      "text": "抓住实质，才是可靠的科学分析方法。",
      "source": "《毛泽东选集》 · 正文摘录 3"
    },
    {
      "id": 4,
      "text": "中国布满干柴，很快就会燃成烈火。",
      "source": "《毛泽东选集》 · 正文摘录 4"
    },
    {
      "id": 5,
      "text": "读书是学习，使用也是学习。",
      "source": "《毛泽东选集》 · 正文摘录 5"
    },
    {
      "id": 6,
      "text": "从战争学习战争，这是我们的主要方法。",
      "source": "《毛泽东选集》 · 正文摘录 6"
    },
    {
      "id": 7,
      "text": "军事家可凭借舞台，导演威武雄壮的活剧。",
      "source": "《毛泽东选集》 · 正文摘录 7"
    },
    {
      "id": 8,
      "text": "战略问题，是研究战争全局规律的东西。",
      "source": "《毛泽东选集》 · 正文摘录 8"
    },
    {
      "id": 9,
      "text": "保存军力，待机破敌，是战略退却目的。",
      "source": "《毛泽东选集》 · 正文摘录 9"
    },
    {
      "id": 10,
      "text": "思想合于客观规律，工作才能取得胜利。",
      "source": "《毛泽东选集》 · 正文摘录 10"
    },
    {
      "id": 11,
      "text": "真理的标准只能是社会的实践。",
      "source": "《毛泽东选集》 · 正文摘录 11"
    },
    {
      "id": 12,
      "text": "通过实践发现、证实并发展真理。",
      "source": "《毛泽东选集》 · 正文摘录 12"
    },
    {
      "id": 13,
      "text": "实践、认识、再实践、再认识。",
      "source": "《毛泽东选集》 · 正文摘录 13"
    },
    {
      "id": 14,
      "text": "理解后的东西，才能更深刻地感觉它。",
      "source": "《毛泽东选集》 · 正文摘录 14"
    },
    {
      "id": 15,
      "text": "理论若不实行，再好也没有意义。",
      "source": "《毛泽东选集》 · 正文摘录 15"
    },
    {
      "id": 16,
      "text": "哲学重在能动地改造客观世界。",
      "source": "《毛泽东选集》 · 正文摘录 16"
    },
    {
      "id": 17,
      "text": "矛盾存在于一切事物发展过程之中。",
      "source": "《毛泽东选集》 · 正文摘录 17"
    },
    {
      "id": 18,
      "text": "内因是变化根据，外因通过内因起作用。",
      "source": "《毛泽东选集》 · 正文摘录 18"
    },
    {
      "id": 19,
      "text": "事物发展根本原因，在于内部矛盾性。",
      "source": "《毛泽东选集》 · 正文摘录 19"
    },
    {
      "id": 20,
      "text": "矛盾普遍性寓于矛盾特殊性之中。",
      "source": "《毛泽东选集》 · 正文摘录 20"
    },
    {
      "id": 21,
      "text": "不同质矛盾，用不同质方法解决。",
      "source": "《毛泽东选集》 · 正文摘录 21"
    },
    {
      "id": 22,
      "text": "具体地分析具体情况，是活的灵魂。",
      "source": "《毛泽东选集》 · 正文摘录 22"
    },
    {
      "id": 23,
      "text": "捉住主要矛盾，一切问题迎刃而解。",
      "source": "《毛泽东选集》 · 正文摘录 23"
    },
    {
      "id": 24,
      "text": "事物性质由矛盾主要方面所规定。",
      "source": "《毛泽东选集》 · 正文摘录 24"
    },
    {
      "id": 25,
      "text": "矛盾双方，在一定条件下互相转化。",
      "source": "《毛泽东选集》 · 正文摘录 25"
    },
    {
      "id": 26,
      "text": "对立斗争是绝对的，统一是相对的。",
      "source": "《毛泽东选集》 · 正文摘录 26"
    },
    {
      "id": 27,
      "text": "对抗只是矛盾斗争的一种形式。",
      "source": "《毛泽东选集》 · 正文摘录 27"
    },
    {
      "id": 28,
      "text": "关门主义，是孤家寡人的策略。",
      "source": "《毛泽东选集》 · 正文摘录 28"
    },
    {
      "id": 29,
      "text": "长征是宣言书，是宣传队，是播种机。",
      "source": "《毛泽东选集》 · 正文摘录 29"
    },
    {
      "id": 30,
      "text": "中华民族有自立于世界民族之林的能力。",
      "source": "《毛泽东选集》 · 正文摘录 30"
    },
    {
      "id": 31,
      "text": "积极思想斗争，是党内团结战斗武器。",
      "source": "《毛泽东选集》 · 正文摘录 31"
    },
    {
      "id": 32,
      "text": "自由主义是腐蚀剂，涣散团结消极工作。",
      "source": "《毛泽东选集》 · 正文摘录 32"
    },
    {
      "id": 33,
      "text": "事不关己，高高挂起；明知不对，少说为佳。",
      "source": "《毛泽东选集》 · 正文摘录 33"
    },
    {
      "id": 34,
      "text": "当面不说，背后乱说；开会不说，会后乱说。",
      "source": "《毛泽东选集》 · 正文摘录 34"
    },
    {
      "id": 35,
      "text": "见损害群众利益行为，漠然置之。",
      "source": "《毛泽东选集》 · 正文摘录 35"
    },
    {
      "id": 36,
      "text": "办事敷衍了事，得过且过。",
      "source": "《毛泽东选集》 · 正文摘录 36"
    },
    {
      "id": 37,
      "text": "毫无利己动机，是国际主义共产主义精神。",
      "source": "《毛泽东选集》 · 正文摘录 37"
    },
    {
      "id": 38,
      "text": "一个人能力有大小，但要有这点精神。",
      "source": "《毛泽东选集》 · 正文摘录 38"
    },
    {
      "id": 39,
      "text": "高尚、纯粹、有道德、脱离低级趣味。",
      "source": "《毛泽东选集》 · 正文摘录 39"
    },
    {
      "id": 40,
      "text": "武器重要，但决定战争的是人不是物。",
      "source": "《毛泽东选集》 · 正文摘录 40"
    },
    {
      "id": 41,
      "text": "战争伟力最深厚根源，存在民众之中。",
      "source": "《毛泽东选集》 · 正文摘录 41"
    },
    {
      "id": 42,
      "text": "力量在战争进程中会改变原有形态。",
      "source": "《毛泽东选集》 · 正文摘录 42"
    },
    {
      "id": 43,
      "text": "正确主观指导，改变优劣主动被动。",
      "source": "《毛泽东选集》 · 正文摘录 43"
    },
    {
      "id": 44,
      "text": "主动权来自对客观情况的虚心研究。",
      "source": "《毛泽东选集》 · 正文摘录 44"
    },
    {
      "id": 45,
      "text": "游击战争，一刻也不能离开民众。",
      "source": "《毛泽东选集》 · 正文摘录 45"
    },
    {
      "id": 46,
      "text": "武装夺取政权，是革命中心任务。",
      "source": "《毛泽东选集》 · 正文摘录 46"
    },
    {
      "id": 47,
      "text": "在中国，主要斗争形式是战争。",
      "source": "《毛泽东选集》 · 正文摘录 47"
    },
    {
      "id": 48,
      "text": "知识分子不和工农结合，则一事无成。",
      "source": "《毛泽东选集》 · 正文摘录 48"
    },
    {
      "id": 49,
      "text": "是否结合工农，是知识分子革命分界。",
      "source": "《毛泽东选集》 · 正文摘录 49"
    },
    {
      "id": 50,
      "text": "真理依靠客观实践来检验。",
      "source": "《毛泽东选集》 · 正文摘录 50"
    },
    {
      "id": 51,
      "text": "文化是政治经济在观念形态的反映。",
      "source": "《毛泽东选集》 · 正文摘录 51"
    },
    {
      "id": 52,
      "text": "没有革命理论，就没有革命运动。",
      "source": "《毛泽东选集》 · 正文摘录 52"
    },
    {
      "id": 53,
      "text": "国情，是解决革命问题的基本依据。",
      "source": "《毛泽东选集》 · 正文摘录 53"
    },
    {
      "id": 54,
      "text": "革命分两步：民主革命，再社会主义革命。",
      "source": "《毛泽东选集》 · 正文摘录 54"
    },
    {
      "id": 55,
      "text": "民主革命是社会主义革命必要准备。",
      "source": "《毛泽东选集》 · 正文摘录 55"
    },
    {
      "id": 56,
      "text": "新民主主义文化，是民族科学大众的文化。",
      "source": "《毛泽东选集》 · 正文摘录 56"
    },
    {
      "id": 57,
      "text": "吸收外来文化，要取其精华去其糟粕。",
      "source": "《毛泽东选集》 · 正文摘录 57"
    },
    {
      "id": 58,
      "text": "清理古文化，剔除糟粕吸收民主精华。",
      "source": "《毛泽东选集》 · 正文摘录 58"
    },
    {
      "id": 59,
      "text": "看问题要从客观事实，不从抽象定义。",
      "source": "《毛泽东选集》 · 正文摘录 59"
    },
    {
      "id": 60,
      "text": "为什么人的问题，是根本原则问题。",
      "source": "《毛泽东选集》 · 正文摘录 60"
    },
    {
      "id": 61,
      "text": "文艺为人民大众，首先为工农兵。",
      "source": "《毛泽东选集》 · 正文摘录 61"
    },
    {
      "id": 62,
      "text": "人民生活，是文艺最丰富原料矿藏。",
      "source": "《毛泽东选集》 · 正文摘录 62"
    },
    {
      "id": 63,
      "text": "文艺作品，是社会生活在头脑的反映。",
      "source": "《毛泽东选集》 · 正文摘录 63"
    },
    {
      "id": 64,
      "text": "代表群众，才能教育群众。",
      "source": "《毛泽东选集》 · 正文摘录 64"
    },
    {
      "id": 65,
      "text": "大众化，就是和工农思想感情打成一片。",
      "source": "《毛泽东选集》 · 正文摘录 65"
    },
    {
      "id": 66,
      "text": "知识分两类：生产斗争与阶级斗争知识。",
      "source": "《毛泽东选集》 · 正文摘录 66"
    },
    {
      "id": 67,
      "text": "完整知识，包含感性与理性两个阶段。",
      "source": "《毛泽东选集》 · 正文摘录 67"
    },
    {
      "id": 68,
      "text": "真理论，是从实际抽出又被实践证明。",
      "source": "《毛泽东选集》 · 正文摘录 68"
    },
    {
      "id": 69,
      "text": "马列和中国实际结合，就是有的放矢。",
      "source": "《毛泽东选集》 · 正文摘录 69"
    },
    {
      "id": 70,
      "text": "主观主义，是共产党的大敌。",
      "source": "《毛泽东选集》 · 正文摘录 70"
    },
    {
      "id": 71,
      "text": "宗派主义妨碍党内团结，脱离群众。",
      "source": "《毛泽东选集》 · 正文摘录 71"
    },
    {
      "id": 72,
      "text": "学风，是对待马列主义的态度问题。",
      "source": "《毛泽东选集》 · 正文摘录 72"
    },
    {
      "id": 73,
      "text": "实事就是客观存在的一切事物。",
      "source": "《毛泽东选集》 · 正文摘录 73"
    },
    {
      "id": 74,
      "text": "无实事求是之意，有哗众取宠之心。",
      "source": "《毛泽东选集》 · 正文摘录 74"
    },
    {
      "id": 75,
      "text": "主观主义是党性不纯的一种表现。",
      "source": "《毛泽东选集》 · 正文摘录 75"
    },
    {
      "id": 76,
      "text": "机关两大任务：了解情况，掌握政策。",
      "source": "《毛泽东选集》 · 正文摘录 76"
    },
    {
      "id": 77,
      "text": "群众是真正的英雄，我们往往幼稚可笑。",
      "source": "《毛泽东选集》 · 正文摘录 77"
    },
    {
      "id": 78,
      "text": "了解情况唯一办法，向社会作调查。",
      "source": "《毛泽东选集》 · 正文摘录 78"
    },
    {
      "id": 79,
      "text": "调查要放下架子，甘当小学生。",
      "source": "《毛泽东选集》 · 正文摘录 79"
    },
    {
      "id": 80,
      "text": "正确领导，必须从群众中来，到群众中去。",
      "source": "《毛泽东选集》 · 正文摘录 80"
    },
    {
      "id": 81,
      "text": "集中群众意见，再回到群众中检验。",
      "source": "《毛泽东选集》 · 正文摘录 81"
    },
    {
      "id": 82,
      "text": "一定时间，只能有一个中心工作。",
      "source": "《毛泽东选集》 · 正文摘录 82"
    },
    {
      "id": 83,
      "text": "统筹全局，决定工作重心是领导艺术。",
      "source": "《毛泽东选集》 · 正文摘录 83"
    },
    {
      "id": 84,
      "text": "我们队伍，彻底为人民利益工作。",
      "source": "《毛泽东选集》 · 正文摘录 84"
    },
    {
      "id": 85,
      "text": "人总是要死的，但死的意义有不同。",
      "source": "《毛泽东选集》 · 正文摘录 85"
    },
    {
      "id": 86,
      "text": "为人民利益而死，重于泰山。",
      "source": "《毛泽东选集》 · 正文摘录 86"
    },
    {
      "id": 87,
      "text": "替压迫者去死，则轻于鸿毛。",
      "source": "《毛泽东选集》 · 正文摘录 87"
    },
    {
      "id": 88,
      "text": "有缺点不怕别人批评指出。",
      "source": "《毛泽东选集》 · 正文摘录 88"
    },
    {
      "id": 89,
      "text": "坚持好的，改正错的，队伍必会兴旺。",
      "source": "《毛泽东选集》 · 正文摘录 89"
    },
    {
      "id": 90,
      "text": "革命队伍，要互相关心爱护帮助。",
      "source": "《毛泽东选集》 · 正文摘录 90"
    },
    {
      "id": 91,
      "text": "人民，只有人民，才创造世界历史。",
      "source": "《毛泽东选集》 · 正文摘录 91"
    },
    {
      "id": 92,
      "text": "一切言论以人民最大利益为最高标准。",
      "source": "《毛泽东选集》 · 正文摘录 92"
    },
    {
      "id": 93,
      "text": "坚持真理，修正错误，符合人民利益。",
      "source": "《毛泽东选集》 · 正文摘录 93"
    },
    {
      "id": 94,
      "text": "自我批评，是我党显著标志之一。",
      "source": "《毛泽东选集》 · 正文摘录 94"
    },
    {
      "id": 95,
      "text": "思想要时常打扫，如同房子要打扫。",
      "source": "《毛泽东选集》 · 正文摘录 95"
    },
    {
      "id": 96,
      "text": "共产党人随时准备牺牲一切。",
      "source": "《毛泽东选集》 · 正文摘录 96"
    },
    {
      "id": 97,
      "text": "下定决心，不怕牺牲，排除万难，去争取胜利。",
      "source": "《毛泽东选集》 · 正文摘录 97"
    },
    {
      "id": 98,
      "text": "要挖掉帝国主义、封建主义两座大山。",
      "source": "《毛泽东选集》 · 正文摘录 98"
    },
    {
      "id": 99,
      "text": "共产党人好比种子，人民好比土地。",
      "source": "《毛泽东选集》 · 正文摘录 99"
    },
    {
      "id": 100,
      "text": "工作就是斗争，为解决困难而斗争。",
      "source": "《毛泽东选集》 · 正文摘录 100"
    },
    {
      "id": 101,
      "text": "越是困难的地方，越是要去。",
      "source": "《毛泽东选集》 · 正文摘录 101"
    },
    {
      "id": 102,
      "text": "艰苦工作摆在面前，看我们敢不敢承担。",
      "source": "《毛泽东选集》 · 正文摘录 102"
    },
    {
      "id": 103,
      "text": "不要拈轻怕重，把重担推给别人。",
      "source": "《毛泽东选集》 · 正文摘录 103"
    },
    {
      "id": 104,
      "text": "世界没有直路，要准备走曲折道路。",
      "source": "《毛泽东选集》 · 正文摘录 104"
    },
    {
      "id": 105,
      "text": "长远看，强大力量属于人民。",
      "source": "《毛泽东选集》 · 正文摘录 105"
    },
    {
      "id": 106,
      "text": "决定战争胜败的是人民，不是新式武器。",
      "source": "《毛泽东选集》 · 正文摘录 106"
    },
    {
      "id": 107,
      "text": "乌云只是暂时现象，曙光在前头。",
      "source": "《毛泽东选集》 · 正文摘录 107"
    },
    {
      "id": 108,
      "text": "不打无准备之仗，不打无把握之仗。",
      "source": "《毛泽东选集》 · 正文摘录 108"
    },
    {
      "id": 109,
      "text": "命运，应当由我们自己掌握。",
      "source": "《毛泽东选集》 · 正文摘录 109"
    },
    {
      "id": 110,
      "text": "土地改革，是新民主主义革命主要内容。",
      "source": "《毛泽东选集》 · 正文摘录 110"
    },
    {
      "id": 111,
      "text": "新民主主义三大经济纲领。",
      "source": "《毛泽东选集》 · 正文摘录 111"
    },
    {
      "id": 112,
      "text": "团结各方，建立民族统一战线。",
      "source": "《毛泽东选集》 · 正文摘录 112"
    },
    {
      "id": 113,
      "text": "凡是敌人反对的，我们就要拥护。",
      "source": "《毛泽东选集》 · 正文摘录 113"
    },
    {
      "id": 114,
      "text": "敌人的激将法，应当束之高阁。",
      "source": "《毛泽东选集》 · 正文摘录 114"
    },
    {
      "id": 115,
      "text": "从具体情况出发，决定任务方法。",
      "source": "《毛泽东选集》 · 正文摘录 115"
    },
    {
      "id": 116,
      "text": "中国人死都不怕，还怕困难吗？",
      "source": "《毛泽东选集》 · 正文摘录 116"
    },
    {
      "id": 117,
      "text": "封锁十年八年，中国问题都能解决。",
      "source": "《毛泽东选集》 · 正文摘录 117"
    },
    {
      "id": 118,
      "text": "善于破坏旧世界，也善于建设新世界。",
      "source": "《毛泽东选集》 · 正文摘录 118"
    },
    {
      "id": 119,
      "text": "夺取全国胜利，只是万里长征第一步。",
      "source": "《毛泽东选集》 · 正文摘录 119"
    },
    {
      "id": 120,
      "text": "革命之后路程更长，工作更伟大艰苦。",
      "source": "《毛泽东选集》 · 正文摘录 120"
    },
    {
      "id": 121,
      "text": "务必谦虚谨慎、不骄不躁。",
      "source": "《毛泽东选集》 · 正文摘录 121"
    },
    {
      "id": 122,
      "text": "务必保持艰苦奋斗的作风。",
      "source": "《毛泽东选集》 · 正文摘录 122"
    },
    {
      "id": 123,
      "text": "军阀混战，削弱白色政权统治。",
      "source": "《毛泽东选集》 · 正文摘录 123"
    },
    {
      "id": 124,
      "text": "红军存在，是红色政权必要条件。",
      "source": "《毛泽东选集》 · 正文摘录 124"
    },
    {
      "id": 125,
      "text": "政策不错误，红色政权方能长期发展。",
      "source": "《毛泽东选集》 · 正文摘录 125"
    },
    {
      "id": 126,
      "text": "边界斗争，完全是军事的斗争。",
      "source": "《毛泽东选集》 · 正文摘录 126"
    },
    {
      "id": 127,
      "text": "红军打仗，为宣传组织武装群众。",
      "source": "《毛泽东选集》 · 正文摘录 127"
    },
    {
      "id": 128,
      "text": "初战计划，是全战役计划的序幕。",
      "source": "《毛泽东选集》 · 正文摘录 128"
    },
    {
      "id": 129,
      "text": "打第一仗，要顾及后续各次战斗。",
      "source": "《毛泽东选集》 · 正文摘录 129"
    },
    {
      "id": 130,
      "text": "懂得全局，才能用好局部。",
      "source": "《毛泽东选集》 · 正文摘录 130"
    },
    {
      "id": 131,
      "text": "全局关照好坏，决定战争胜败。",
      "source": "《毛泽东选集》 · 正文摘录 131"
    },
    {
      "id": 132,
      "text": "指挥员首要，关注战争全局。",
      "source": "《毛泽东选集》 · 正文摘录 132"
    },
    {
      "id": 133,
      "text": "侦察思索，形成指挥员正确判断。",
      "source": "《毛泽东选集》 · 正文摘录 133"
    },
    {
      "id": 134,
      "text": "计划建立在空想，必然不符合实际。",
      "source": "《毛泽东选集》 · 正文摘录 134"
    },
    {
      "id": 135,
      "text": "战争有相对确实性，并非完全无迹。",
      "source": "《毛泽东选集》 · 正文摘录 135"
    },
    {
      "id": 136,
      "text": "战争指导规律随战争发展而变化。",
      "source": "《毛泽东选集》 · 正文摘录 136"
    },
    {
      "id": 137,
      "text": "不能超出物质条件，强求战争胜利。",
      "source": "《毛泽东选集》 · 正文摘录 137"
    },
    {
      "id": 138,
      "text": "矛盾斗争贯串事物发展全程。",
      "source": "《毛泽东选集》 · 正文摘录 138"
    },
    {
      "id": 139,
      "text": "形而上学用孤立静止片面看世界。",
      "source": "《毛泽东选集》 · 正文摘录 139"
    },
    {
      "id": 140,
      "text": "党内思想对立，是社会矛盾的反映。",
      "source": "《毛泽东选集》 · 正文摘录 140"
    },
    {
      "id": 141,
      "text": "对抗性矛盾，要用对抗形式解决。",
      "source": "《毛泽东选集》 · 正文摘录 141"
    },
    {
      "id": 142,
      "text": "事物性质随矛盾主次方面转化而变。",
      "source": "《毛泽东选集》 · 正文摘录 142"
    },
    {
      "id": 143,
      "text": "统一战线，收集敌人营垒一切缺口。",
      "source": "《毛泽东选集》 · 正文摘录 143"
    },
    {
      "id": 144,
      "text": "民族敌人深入国土，起决定作用。",
      "source": "《毛泽东选集》 · 正文摘录 144"
    },
    {
      "id": 145,
      "text": "革命转变，是将来才会发生的事。",
      "source": "《毛泽东选集》 · 正文摘录 145"
    },
    {
      "id": 146,
      "text": "革命性质，是资产阶级民主革命。",
      "source": "《毛泽东选集》 · 正文摘录 146"
    },
    {
      "id": 147,
      "text": "共产党员不争个人兵权，争人民兵权。",
      "source": "《毛泽东选集》 · 正文摘录 147"
    },
    {
      "id": 148,
      "text": "一切外国东西，要咀嚼消化吸收精华。",
      "source": "《毛泽东选集》 · 正文摘录 148"
    },
    {
      "id": 149,
      "text": "形式主义照搬外国，过去吃过大亏。",
      "source": "《毛泽东选集》 · 正文摘录 149"
    },
    {
      "id": 150,
      "text": "新民主主义文化，为劳苦大众服务。",
      "source": "《毛泽东选集》 · 正文摘录 150"
    },
    {
      "id": 151,
      "text": "新民主主义文化主张客观真理。",
      "source": "《毛泽东选集》 · 正文摘录 151"
    },
    {
      "id": 152,
      "text": "文艺把矛盾典型化，唤醒人民斗争。",
      "source": "《毛泽东选集》 · 正文摘录 152"
    },
    {
      "id": 153,
      "text": "革命文艺，是生活在头脑的能动反映。",
      "source": "《毛泽东选集》 · 正文摘录 153"
    },
    {
      "id": 154,
      "text": "感性知识，是理性知识发展基础。",
      "source": "《毛泽东选集》 · 正文摘录 154"
    },
    {
      "id": 155,
      "text": "理论脱离实际，就是无的放矢。",
      "source": "《毛泽东选集》 · 正文摘录 155"
    },
    {
      "id": 156,
      "text": "反对主观主义，宣传唯物辩证法。",
      "source": "《毛泽东选集》 · 正文摘录 156"
    },
    {
      "id": 157,
      "text": "夸夸其谈一大篇，脱离客观实际。",
      "source": "《毛泽东选集》 · 正文摘录 157"
    },
    {
      "id": 158,
      "text": "阶级分析，是研究社会的基本方法。",
      "source": "《毛泽东选集》 · 正文摘录 158"
    },
    {
      "id": 159,
      "text": "分散意见集中，再化为群众意见。",
      "source": "《毛泽东选集》 · 正文摘录 159"
    },
    {
      "id": 160,
      "text": "领导意见，要在群众行动中考验。",
      "source": "《毛泽东选集》 · 正文摘录 160"
    },
    {
      "id": 161,
      "text": "批评只要对人民有利，我们就接受。",
      "source": "《毛泽东选集》 · 正文摘录 161"
    },
    {
      "id": 162,
      "text": "共产党人不惜牺牲，殉于正义事业。",
      "source": "《毛泽东选集》 · 正文摘录 162"
    },
    {
      "id": 163,
      "text": "思想沾染灰尘，应当打扫洗涤。",
      "source": "《毛泽东选集》 · 正文摘录 163"
    },
    {
      "id": 164,
      "text": "人民拥护，是衡量言论行动标尺。",
      "source": "《毛泽东选集》 · 正文摘录 164"
    },
    {
      "id": 165,
      "text": "真理与人民利益，二者完全一致。",
      "source": "《毛泽东选集》 · 正文摘录 165"
    },
    {
      "id": 166,
      "text": "自我批评，清扫思想的灰尘。",
      "source": "《毛泽东选集》 · 正文摘录 166"
    },
    {
      "id": 167,
      "text": "依靠人民，就能挖掉压迫的大山。",
      "source": "《毛泽东选集》 · 正文摘录 167"
    },
    {
      "id": 168,
      "text": "种子和土地结合，方能生根开花。",
      "source": "《毛泽东选集》 · 正文摘录 168"
    },
    {
      "id": 169,
      "text": "斗争就是解决困难，完成工作任务。",
      "source": "《毛泽东选集》 · 正文摘录 169"
    },
    {
      "id": 170,
      "text": "担子摆在面前，考验担当的勇气。",
      "source": "《毛泽东选集》 · 正文摘录 170"
    },
    {
      "id": 171,
      "text": "贪图捷径，往往走上曲折弯路。",
      "source": "《毛泽东选集》 · 正文摘录 171"
    },
    {
      "id": 172,
      "text": "反动派外表可怕，实际力量虚弱。",
      "source": "《毛泽东选集》 · 正文摘录 172"
    },
    {
      "id": 173,
      "text": "武器只是工具，人民才是力量本源。",
      "source": "《毛泽东选集》 · 正文摘录 173"
    },
    {
      "id": 174,
      "text": "黑暗是暂时，革命曙光终会到来。",
      "source": "《毛泽东选集》 · 正文摘录 174"
    },
    {
      "id": 175,
      "text": "战前充分准备，方能把握作战胜算。",
      "source": "《毛泽东选集》 · 正文摘录 175"
    },
    {
      "id": 176,
      "text": "依靠群众力量，掌握自己的命运。",
      "source": "《毛泽东选集》 · 正文摘录 176"
    },
    {
      "id": 177,
      "text": "耕者有其田，是土地改革核心。",
      "source": "《毛泽东选集》 · 正文摘录 177"
    },
    {
      "id": 178,
      "text": "保护民族工商业，是革命纲领之一。",
      "source": "《毛泽东选集》 · 正文摘录 178"
    },
    {
      "id": 179,
      "text": "团结一切爱国者，建立民主联合政府。",
      "source": "《毛泽东选集》 · 正文摘录 179"
    },
    {
      "id": 180,
      "text": "政策错一步，革命事业便受损失。",
      "source": "《毛泽东选集》 · 正文摘录 180"
    },
    {
      "id": 181,
      "text": "敌人拥护的事物，我们就要反对。",
      "source": "《毛泽东选集》 · 正文摘录 181"
    },
    {
      "id": 182,
      "text": "面对激将挑衅，保持冷静不予理会。",
      "source": "《毛泽东选集》 · 正文摘录 182"
    },
    {
      "id": 183,
      "text": "因地制宜，制定当地工作任务。",
      "source": "《毛泽东选集》 · 正文摘录 183"
    },
    {
      "id": 184,
      "text": "不惧封锁压迫，自力更生谋发展。",
      "source": "《毛泽东选集》 · 正文摘录 184"
    },
    {
      "id": 185,
      "text": "知识分子挺起脊梁，坚守民族骨气。",
      "source": "《毛泽东选集》 · 正文摘录 185"
    },
    {
      "id": 186,
      "text": "建设新世界，依靠人民持续奋斗。",
      "source": "《毛泽东选集》 · 正文摘录 186"
    },
    {
      "id": 187,
      "text": "胜利只是开端，艰巨任务尚在后面。",
      "source": "《毛泽东选集》 · 正文摘录 187"
    },
    {
      "id": 188,
      "text": "戒骄戒躁，艰苦奋斗，长久坚持。",
      "source": "《毛泽东选集》 · 正文摘录 188"
    }
  ]
}
